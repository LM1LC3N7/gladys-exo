    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options"
      },
      "description": {
        "en": "The feeds are read every interval (one request per network, whatever the number of stops), the alerts every 5 minutes at most.",
        "fr": "Les flux sont lus à chaque intervalle (une requête par réseau, quel que soit le nombre d’arrêts), les avis toutes les 5 minutes au plus."
      }
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the values",
        "fr": "Langue des valeurs"
      },
      "description": {
        "en": "Language of the feature names, of the published texts and of the alerts when exo gives both.",
        "fr": "Langue des noms de fonctionnalités, des textes publiés et des avis quand exo donne les deux."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    },
    {
      "key": "poll_seconds",
      "type": "number",
      "label": {
        "en": "Read interval (seconds)",
        "fr": "Intervalle de lecture (secondes)"
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 600
    },
    {
      "key": "lookahead_minutes",
      "type": "number",
      "label": {
        "en": "Departures shown up to (minutes ahead)",
        "fr": "Passages pris en compte jusqu’à (minutes)"
      },
      "required": false,
      "default": 90,
      "min": 15,
      "max": 240
    },
    {
      "key": "alerts",
      "type": "boolean",
      "label": {
        "en": "Read the service alerts",
        "fr": "Lire les avis de service"
      },
      "description": {
        "en": "Adds the number of active alerts of the stop and the text of the main one.",
        "fr": "Ajoute le nombre d’avis actifs de l’arrêt et le texte du principal."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 45,
      "label": {
        "en": "Test the key",
        "fr": "Tester la clé"
      },
      "description": {
        "en": "Sends one request to the Chrono portal (at most every 30 s) and tells whether it accepts the key. A success lifts a refusal.",
        "fr": "Envoie une requête au portail Chrono (au plus toutes les 30 s) et dit s’il accepte la clé. Un succès lève un refus."
      }
    }
